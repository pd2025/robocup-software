#include "rj_strategy/agent/position/dribbler.hpp"

namespace strategy {
    Dribbler::Dribbler(int r_id) : Position{r_id, "Dribbler"} {}
    Dribbler::Dribbler(const Position& other) : Position{other} {}

    std::string Dribbler::get_current_state() { 
        return "Dribbler"; 
    }

    std::optional<RobotIntent> Dribbler::derived_get_task(RobotIntent intent) {
        // set current state to next state
        State new_state = next_state();
        current_state_ = new_state;
        return state_to_task(intent);
    }

    std::string Dribbler::get_current_state() {
        return std::string{"Dribbler"} + std::to_string(static_cast<int>(current_state_));
    }

    Dribbler::State Dribbler::next_state() {
        // transition between states
    }

    // gets called once per 'tick'
    std::optional<RobotIntent> Dribbler::state_to_task(RobotIntent intent) {
        if (!last_world_state_) {
            return std::nullopt;
        }

        // get ball position
        rj_geometry::Point ball_pos = {
            last_world_state_->ball.position.x(),
            last_world_state_->ball.position.y()
        };

        // get robot position
        rj_geometry::Point robot_pos = {
            last_world_state_->get_robot(true, robot_id_).pose.position().x(),
            last_world_state_->get_robot(true, robot_id_).pose.position().y()
        };

        // drive to ball position
        planning::LinearMotionInstant target{ball_pos};
        planning::MotionCommand drive_cmd{
            "path_target",
            target,
            planning::FaceTarget{}
        };

        intent.motion_command = drive_cmd;

        return intent;
    }
}